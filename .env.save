# Copy this file to ".env" and fill in ONLY the API(s) you want to use.
# ".env" is re-read automatically when you save it – the "API not configured" banner on the site
# disappears by itself once a key below is valid (no restart needed).
# Never commit ".env". Keys stay on the server and are never sent to the browser.

PORT=3000
HOST=0.0.0.0
# Public address of your site (canonical URLs, sitemap, Open Graph)
SITE_URL=https://your-domain.com
# Set to 1 behind nginx / Cloudflare / a PaaS proxy (so rate limits see the real visitor IP)
TRUST_PROXY=RATE_LIMIT_PER_MIN=20

# auto     = try every configured provider in this order: graph -> rapidapi -> custom
# or force one:  graph | rapidapi | custom
PROVIDER=auto

# ---------------------------------------------------------------------------
# 1) RapidAPI – any "Instagram downloader" API from https://rapidapi.com
#    Subscribe to the API you chose (check its pricing/terms yourself), then copy the values
#    from its "Code Snippets" tab:
#       X-RapidAPI-Key   -> RAPIDAPI_KEY
#       X-RapidAPI-Host  -> RAPIDAPI_HOST
#       the request path -> RAPIDAPI_ENDPOINT   ({url} = the Instagram link, URL-encoded)
#    Reels, Posts and Stories links are all passed through as {url}.
# --------------------------------------------------------------------------
RAPIDAPI_KEY=
RAPIDAPI_HOST=

# Examples:  /convert?url={url}      /v1/media?link={url}      /?url={url}
RAPIDAPI_ENDPOINT=/?url={url}
RAPIDAPI_METHOD=GET
# For POST APIs, a JSON body template, e.g. {"url":"{url}"}
RAPIDAPI_BODY=
# OPTIONAL. Leave empty: the server scans the JSON response and finds the video / thumbnail / caption itself.
# Only set these if an API returns several videos and you need a specific one (dot paths, e.g. data.medias.0.url)
RAPIDAPI_VIDEO_PATH=
RAPIDAPI_THUMB_PATH=
RAPIDAPI_TITLE_PATH=
# OPTIONAL. Audio-only: normally auto-detected when the API returns an audio file (audio_url, mp3, .m4a/.mp3 link).
# Set this dot path (e.g. data.audio.url) only if your API uses an unusual field. No audio from the API = no audio button
# (the server never converts or invents audio).
RAPIDAPI_AUDIO_PATH=

# ---------------------------------------------------------------------------
# 2) Official Instagram API (free). Works for the account that owns the token only:
#    its own Reels, Posts and Stories.
#    Meta app: https://developers.facebook.com/apps -> add "Instagram" -> generate a token with
#    the instagram_business_basic permission for your Business/Creator account.
# ---------------------------------------------------------------------------
IG_ACCESS_TOKEN=
# IG_API_BASE=https://graph.instagram.com/v21.0
# IG_MAX_PAGES=10

# ---------------------------------------------------------------------------
# 3) Any other HTTP/JSON API (not RapidAPI). Disabled while CUSTOM_API_URL is empty.
#    Placeholders: {url} {shortcode} {username}
# ---------------------------------------------------------------------------
CUSTOM_API_URCUSTOM_API_METHOD=GET
# Headers as one-line JSON, e.g. {"X-Api-Key":"YOUR_KEY"}
CUSTOM_API_HEADERS=
CUSTOM_API_BODY=
CUSTOM_VIDEO_PATH=
CUSTOM_THUMB_PATH=
CUSTOM_TITLE_PATH=
CUSTOM_AUDIO_PATH=

# ---------------------------------------------------------------------------
# Admin dashboard (/admin) – disabled until BOTH values below are set.
# Create the hash with:  npm run admin:hash   (never put a plain password in .env)
# ---------------------------------------------------------------------------
ADMIN_USER=pavan
ADMIN_PASSWORD_HASH=pavan190
ADMIN_SESSION_MINUTES=60

# ---------------------------------------------------------------------------
# Persistent storage (stats, feedback, contact messages)
#   Render : add a Disk (e.g. mount path /var/data) and set DATA_DIR=/var/data
#   VPS    : any writable folder, e.g. DATA_DIR=/var/lib/insta-downloader
# Fallback chain if DATA_DIR is empty or not writable (the app never crashes):
#   ./data  ->  OS temp folder  ->  memory only (lost on restart).
# The admin dashboard (System card) and the start-up log show which one is active.
# ---------------------------------------------------------------------------
DATA_DIR=

# error | warn | info | debug
LOG_LEVEL=info
